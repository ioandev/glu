# GLU API — development environment (ADR 11).
# Copy to `backend/.env` and fill in — or run `just backend env`, which does it
# for you. NEVER commit the real file (`.env*` is gitignored).
#
# Register TWO Todoist apps in the App Management Console
# (https://app.todoist.com/app/settings/integrations/developer) — one for
# development, one for production. One app with a production redirect and a dev
# flow that cannot complete is the classic OAuth time-waster.
#
#   development redirect URI: http://localhost:3000/glu/api/auth/todoist/callback
#   production  redirect URI: https://ioan.dev/glu/api/auth/todoist/callback

TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Seals the httpOnly cookie that holds the Todoist token set. 32+ characters.
# Generate a fresh one per environment:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Leave EMPTY here — filling this file with a real-looking value is how secrets
# get committed by accident. Without it the server falls back to an obviously
# fake development key.
SESSION_SECRET=

# Public origin of the app. Drives the redirect URI and the `Secure` cookie flag.
PUBLIC_ORIGIN=http://localhost:3000

# Port the API listens on. The repo root's `just dev` starts Next on 3000 and
# this on 4000; `just backend dev` starts this one alone.
API_PORT=4000
