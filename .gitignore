# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are deliberately unanchored: web/ and backend/ are separate packages
# with their own node_modules and build outputs, so a leading `/` would only
# ever match the (now empty) repo root.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (web/)
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed) — the examples are committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static/

# playwright
test-results/
playwright-report/
blob-report/

# backend build output (backend/dist)
dist/
