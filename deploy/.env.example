# GLU deployment secrets (ADR 16 Phase B / ADR 11).
# Copy to /srv/glu/.env on the server and fill in. NEVER commit the real file —
# `.env*` is gitignored, keep it that way.

# --- Todoist OAuth app (ADR 11) -------------------------------------------
# Register two apps at https://developer.todoist.com/appconsole.html — one for
# local development, one for production — and use each app's own pair here.
# Redirect URI (production): https://ioan.dev/glu/api/auth/todoist/callback
# Redirect URI (development): http://localhost:4000/glu/api/auth/todoist/callback
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# --- Session sealing key (ADR 11) -----------------------------------------
# The Todoist access token never leaves the server in readable form: it is
# sealed into an httpOnly cookie with this key. 32+ random bytes, base64.
# Generate a fresh one per environment, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Leave EMPTY here — filling this file with a real-looking value is how secrets
# get committed by accident.
SESSION_SECRET=

# --- Public origin --------------------------------------------------------
# Used to build the OAuth redirect URI and to set the cookie domain.
PUBLIC_ORIGIN=https://ioan.dev

# --- TLS (ADR 16 Phase B, nginx-proxy + acme-companion) --------------------
# Where Let's Encrypt sends expiry warnings. acme-companion refuses to start
# without it, which is why compose declares it required. Not a secret — it is
# here because it is deployment config, and .env is where that lives.
ACME_EMAIL=
